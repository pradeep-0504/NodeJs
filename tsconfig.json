{
  "compilerOptions": {
    "target": "ES2022",                          /* Output modern JavaScript features */
    "module": "Node16",                          /* Use Node.js modern module standards */
    "moduleResolution": "Node16",                /* Match module resolution to the runtime */
    "outDir": "./dist",                          /* Redirect output structure to the directory */
    "rootDir": "src",                          /* Specify the root folder of input files */
    
    /* Strict Type-Checking Options */
    "strict": true,                              /* Enable all strict type-checking options */
    "noImplicitAny": true,                       /* Raise error on expressions and declarations with an implied 'any' type */
    
    /* Additional Checks */
    "esModuleInterop": true,                     /* Emit additional JavaScript to ease support for importing CommonJS modules */
    "forceConsistentCasingInFileNames": true,    /* Disallow inconsistently-cased references to the same file */
    "skipLibCheck": true ,
    "types": ["node"]                        /* Skip type checking of declaration files */
  },
  "include": ["src/**/*"],                       /* Compile everything in the src directory */
  "exclude": ["node_modules", "dist", "**/*.spec.ts"] /* Ignore build files, dependencies, and tests */
}
